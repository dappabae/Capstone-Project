{
  "info": {
    "name": "Clinic API Collection",
    "description": "Postman collection for Clinic Backend API (NestJS + PostgreSQL)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_variable_scope": "variables"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "Patients",
      "item": [
        {
          "name": "Get All Patients",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/patients",
            "description": "Get all patients"
          }
        },
        {
          "name": "Get Patient by ID",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/patients/:id",
            "description": "Get patient by ID",
            "urlParams": [
              {
                "key": "id",
                "value": "1",
                "description": "Patient ID"
              }
            ]
          }
        },
        {
          "name": "Create Patient",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/patients",
            "description": "Create a new patient",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"birthDate\": \"1990-01-15\",\n  \"gender\": \"Laki-laki\",\n  \"address\": \"Jl. Merdeka No. 123, Jakarta\",\n  \"phone\": \"08123456789\"\n}"
            }
          }
        },
        {
          "name": "Update Patient",
          "request": {
            "method": "PATCH",
            "url": "{{base_url}}/patients/:id",
            "description": "Update patient by ID",
            "urlParams": [
              {
                "key": "id",
                "value": "1",
                "description": "Patient ID"
              }
            ],
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe Updated\"\n}"
            }
          }
        },
        {
          "name": "Delete Patient",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/patients/:id",
            "description": "Delete patient by ID",
            "urlParams": [
              {
                "key": "id",
                "value": "1",
                "description": "Patient ID"
              }
            ]
          }
        }
      ]
    },
